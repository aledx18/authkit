---
import "@/styles/global.css";
import { actions, isInputError } from "astro:actions";
import { requireGuest } from "@aledx18/astro/protect";
import Button from "@/components/ui/Button.astro";
import Input from "@/components/ui/Input.astro";

const redirectResponse = requireGuest(Astro);
if (redirectResponse) return redirectResponse;

const result = Astro.getActionResult(actions.forgotPassword);
if (result && !result.error && result.data?.ok) {
  return Astro.redirect("/forgot-password?sent=1");
}

// biome-ignore lint/correctness/noUnusedVariables: used in template
const inputErrors = isInputError(result?.error) ? result.error.fields : {};
// biome-ignore lint/correctness/noUnusedVariables: used in template
const authError = result?.data && !result.data.ok ? result.data.error : undefined;
// biome-ignore lint/correctness/noUnusedVariables: used in template
const sent = Astro.url.searchParams.get("sent");
---

<html>
  <head><title>Forgot password</title></head>
  <body>
    <div class="flex min-h-svh flex-col items-center justify-center gap-6 bg-background p-6 md:p-10">
      <div class="w-full max-w-sm">
        <div class="flex flex-col gap-6">
          <form method="POST" action={actions.forgotPassword}>
            <div class="group/field-group @container/field-group flex w-full flex-col gap-5 data-[slot=checkbox-group]:gap-3 *:data-[slot=field-group]:gap-4">
              <div class="flex flex-col items-center gap-2 text-center">
                <h1 class="text-xl font-bold">Forgot password</h1>
                <div class="text-left text-sm leading-normal font-normal text-muted-foreground group-has-data-horizontal/field:text-balance [[data-variant=legend]+&]:-mt-1.5 last:mt-0 nth-last-2:-mt-1 [&>a]:underline [&>a]:underline-offset-4 [&>a:hover]:text-primary">
                  Enter your email and we'll send you a reset link. <a href="/signin">Back to sign in</a>
                </div>
              </div>
              {sent && (
                <p class="text-sm text-primary">Check your email for the reset link.</p>
              )}
              {authError && (
                <p class="text-sm text-destructive">{authError}</p>
              )}
              <div class="group/field flex w-full flex-col gap-2">
                <label for="email" class="text-sm font-medium leading-none text-foreground">
                  Email
                </label>
                <Input
                  id="email"
                  type="email"
                  name="email"
                  placeholder="you@example.com"
                  required
                  aria-invalid={inputErrors.email ? "true" : undefined}
                  aria-describedby={inputErrors.email ? "email-error" : undefined}
                />
                {inputErrors.email && (
                  <p id="email-error" class="text-sm text-destructive">
                    {inputErrors.email.join(", ")}
                  </p>
                )}
              </div>
              <div class="group/field flex w-full gap-2 flex-col *:w-full [&>.sr-only]:w-auto">
                <Button type="submit">Send reset link</Button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </body>
</html>
