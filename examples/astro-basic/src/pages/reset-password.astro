---
import "@/styles/global.css";
import { actions, isInputError } from "astro:actions";
import { createSupabaseServerClient } from "@aledx18/astro/server";
import Button from "@/components/ui/Button.astro";
import Input from "@/components/ui/Input.astro";

const code = Astro.url.searchParams.get("code");

let linkInvalid = false;
if (code) {
  const supabase = createSupabaseServerClient({
    request: Astro.request,
    cookies: Astro.cookies,
  });
  const { error } = await supabase.auth.exchangeCodeForSession(code);
  if (error) {
    linkInvalid = true;
  } else {
    // PRG: clean the code out of the URL, session cookies are already set
    return Astro.redirect("/reset-password");
  }
}

const result = Astro.getActionResult(actions.updatePassword);
if (result && !result.error && result.data?.ok) {
  return Astro.redirect("/signin?passwordChanged=1");
}

const inputErrors = isInputError(result?.error) ? result.error.fields : {};
const authError = result?.data && !result.data.ok ? result.data.error : undefined;
---

<html>
  <head><title>Reset password</title></head>
  <body>
    <div class="flex min-h-svh flex-col items-center justify-center gap-6 bg-background p-6 md:p-10">
      <div class="w-full max-w-sm">
        <div class="flex flex-col gap-6">
          {linkInvalid ? (
            <div class="text-center">
              <h1 class="text-xl font-bold mb-2">Reset password</h1>
              <p class="text-sm text-destructive">
                This link is invalid or expired.{" "}
                <a href="/forgot-password" class="underline underline-offset-4 text-primary">
                  Request a new one
                </a>.
              </p>
            </div>
          ) : (
            <form method="POST" action={actions.updatePassword}>
              <div class="group/field-group @container/field-group flex w-full flex-col gap-5 data-[slot=checkbox-group]:gap-3 *:data-[slot=field-group]:gap-4">
                <div class="flex flex-col items-center gap-2 text-center">
                  <h1 class="text-xl font-bold">Reset password</h1>
                  <div class="text-left text-sm leading-normal font-normal text-muted-foreground group-has-data-horizontal/field:text-balance [[data-variant=legend]+&]:-mt-1.5 last:mt-0 nth-last-2:-mt-1">
                    Choose a new password for your account.
                  </div>
                </div>
                {authError && (
                  <p class="text-sm text-destructive">{authError}</p>
                )}
                <div class="group/field flex w-full flex-col gap-2">
                  <label for="password" class="text-sm font-medium leading-none text-foreground">
                    New password
                  </label>
                  <Input
                    id="password"
                    type="password"
                    name="password"
                    required
                    minlength="6"
                    aria-invalid={inputErrors.password ? "true" : undefined}
                    aria-describedby={inputErrors.password ? "password-error" : undefined}
                  />
                  {inputErrors.password && (
                    <p id="password-error" class="text-sm text-destructive">
                      {inputErrors.password.join(", ")}
                    </p>
                  )}
                </div>
                <div class="group/field flex w-full gap-2 flex-col *:w-full [&>.sr-only]:w-auto">
                  <Button type="submit">Update password</Button>
                </div>
              </div>
            </form>
          )}
        </div>
      </div>
    </div>
  </body>
</html>
