---
import { actions, isInputError } from "astro:actions";
import { createSupabaseServerClient } from "@aledx18/astro/server";

const code = Astro.url.searchParams.get("code");

// biome-ignore lint/correctness/noUnusedVariables: used in template
let linkInvalid = false;
if (code) {
  const supabase = createSupabaseServerClient({
    request: Astro.request,
    cookies: Astro.cookies,
  });
  const { error } = await supabase.auth.exchangeCodeForSession(code);
  if (error) {
    linkInvalid = true;
  } else {
    // PRG: clean the code out of the URL, session cookies are already set
    return Astro.redirect("/reset-password");
  }
}

const result = Astro.getActionResult(actions.updatePassword);
if (result && !result.error && result.data?.ok) {
  return Astro.redirect("/signin?passwordChanged=1");
}

// biome-ignore lint/correctness/noUnusedVariables: used in template
const inputErrors = isInputError(result?.error) ? result.error.fields : {};
// biome-ignore lint/correctness/noUnusedVariables: used in template
const authError = result?.data && !result.data.ok ? result.data.error : undefined;
---

<html>
  <head><title>Reset password</title></head>
  <body>
    <h1>Reset password</h1>
    {linkInvalid && (
      <p>
        This link is invalid or expired. <a href="/forgot-password">Request a new one</a>.
      </p>
    )}
    {!linkInvalid && (
      <>
        {authError && <p>{authError}</p>}
        {inputErrors.password && <p>{inputErrors.password.join(", ")}</p>}
        <form method="POST" action={actions.updatePassword}>
          <label>
            New password
            <input type="password" name="password" required minlength="6" />
          </label>
          <button type="submit">Update password</button>
        </form>
      </>
    )}
  </body>
</html>
