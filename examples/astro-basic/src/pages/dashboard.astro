---
import "@/styles/global.css";
import { actions } from "astro:actions";
import { requireAuth } from "astro-auth-integration/protect";
import Button from "@/components/ui/Button.astro";

const redirectResponse = requireAuth(Astro);
if (redirectResponse) return redirectResponse;

const signOutResult = Astro.getActionResult(actions.signout);
if (signOutResult && !signOutResult.error) {
  return Astro.redirect("/signin");
}

const user = Astro.locals.user;
---

<html>
  <head><title>Dashboard</title></head>
  <body class="min-h-svh bg-background">
    <header class="border-b bg-card">
      <div class="mx-auto flex h-14 max-w-3xl items-center justify-between px-4">
        <h1 class="text-lg font-semibold text-foreground">Dashboard</h1>
        <form method="POST" action={actions.signout}>
          <Button variant="outline" type="submit">Sign out</Button>
        </form>
      </div>
    </header>
    <main class="mx-auto max-w-3xl px-4 py-8">
      <div class="rounded-xl bg-card p-6 ring-1 ring-foreground/10">
        <p class="text-sm text-muted-foreground">
          Welcome, <span class="font-medium text-foreground">{user?.email ?? "unknown"}</span>
        </p>
      </div>
    </main>
  </body>
</html>
