<html>
  <head><title>Sign In</title></head>
  <body>
    <h1>Sign In</h1>
    <form method="post" action="/api/login">
      <label>
        Email
        <input type="email" name="email" required />
      </label>
      <label>
        Password
        <input type="password" name="password" required />
      </label>
      <button type="submit">Sign in</button>
    </form>
  </body>
</html>
