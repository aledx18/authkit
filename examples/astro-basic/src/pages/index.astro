---
// biome-ignore lint/correctness/noUnusedVariables: used in template
const user = Astro.locals.user;
---

<html>
  <head><title>AuthKit example</title></head>
  <body>
    <h1>AuthKit + Astro</h1>
    {user ? (
      <p>Welcome back, {user.email} — <a href="/dashboard">go to dashboard</a></p>
    ) : (
      <p>
        <a href="/signin">Sign in</a> · <a href="/register">Create an account</a>
      </p>
    )}
  </body>
</html>
