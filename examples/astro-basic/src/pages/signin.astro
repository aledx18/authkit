---
import { actions, isInputError } from "astro:actions";
import { requireGuest } from "@aledx18/astro/protect";

const redirectResponse = requireGuest(Astro);
if (redirectResponse) return redirectResponse;

const result = Astro.getActionResult(actions.signin);
if (result && !result.error && result.data?.ok) {
  return Astro.redirect("/dashboard");
}

// biome-ignore lint/correctness/noUnusedVariables: used in template
const inputErrors = isInputError(result?.error) ? result.error.fields : {};
// biome-ignore lint/correctness/noUnusedVariables: used in template
const authError = result?.data && !result.data.ok ? result.data.error : undefined;
// biome-ignore lint/correctness/noUnusedVariables: used in template
const registered = Astro.url.searchParams.get("registered");
// biome-ignore lint/correctness/noUnusedVariables: used in template
const errorParam = Astro.url.searchParams.get("error");
---

<html>
  <head><title>Sign in</title></head>
  <body>
    <h1>Sign in</h1>
    {registered && <p>Account created — check your email to confirm.</p>}
    {errorParam && <p>{errorParam}</p>}
    {authError && <p>{authError}</p>}
    {inputErrors.email && <p>{inputErrors.email.join(", ")}</p>}
    {inputErrors.password && <p>{inputErrors.password.join(", ")}</p>}
    <form method="POST" action={actions.signin}>
      <label>
        Email
        <input type="email" name="email" required />
      </label>
      <label>
        Password
        <input type="password" name="password" required />
      </label>
      <button type="submit">Sign in</button>
    </form>
    <p><a href="/api/auth/oauth/google">Continue with Google</a> · <a href="/api/auth/oauth/github">Continue with GitHub</a></p>
    <p><a href="/register">Create an account</a></p>
  </body>
</html>
