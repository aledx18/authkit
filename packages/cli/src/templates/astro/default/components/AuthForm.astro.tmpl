---
import Button from "./ui/Button.astro";
import Input from "./ui/Input.astro";

interface Props {
  title: string;
  submitLabel: string;
  /** The astro:actions action (e.g. actions.signin) — typed as string, matching Astro's form action attribute */
  action: string;
  /** Banner shown above the form (success states, e.g. "check your email") */
  successMessage?: string;
  /** General error message (auth errors, query params) */
  authError?: string;
  emailError?: string;
  passwordError?: string;
  /** Header subtitle with a link: { text, linkText, href } */
  subtitle?: { text: string; linkText: string; href: string };
  /** Render the OAuth provider buttons */
  showOAuth?: boolean;
}

const {
  title,
  submitLabel,
  action,
  successMessage,
  authError,
  emailError,
  passwordError,
  subtitle,
  showOAuth = false,
} = Astro.props;
---

<div class="flex min-h-svh flex-col items-center justify-center gap-6 bg-background p-6 md:p-10">
  <div class="w-full max-w-sm">
    <div class="flex flex-col gap-6">
      <form method="POST" action={action}>
        <div class="group/field-group @container/field-group flex w-full flex-col gap-5 data-[slot=checkbox-group]:gap-3 *:data-[slot=field-group]:gap-4">
          <div class="flex flex-col items-center gap-2 text-center">
            <h1 class="text-xl font-bold">{title}</h1>
            {subtitle && (
              <div
                class="text-left text-sm leading-normal font-normal text-muted-foreground group-has-data-horizontal/field:text-balance [[data-variant=legend]+&]:-mt-1.5 last:mt-0 nth-last-2:-mt-1 [&>a]:underline [&>a]:underline-offset-4 [&>a:hover]:text-primary"
              >
                {subtitle.text} <a href={subtitle.href}>{subtitle.linkText}</a>
              </div>
            )}
          </div>
          {successMessage && (
            <p class="text-sm text-primary">{successMessage}</p>
          )}
          {authError && (
            <p class="text-sm text-destructive">{authError}</p>
          )}
          <div class="group/field flex w-full flex-col gap-2">
            <label for="email" class="text-sm font-medium leading-none text-foreground">
              Email
            </label>
            <Input
              id="email"
              type="email"
              name="email"
              placeholder="you@example.com"
              required
              aria-invalid={emailError ? "true" : undefined}
              aria-describedby={emailError ? "email-error" : undefined}
            />
            {emailError && (
              <p id="email-error" class="text-sm text-destructive">
                {emailError}
              </p>
            )}
          </div>
          <div class="group/field flex w-full flex-col gap-2">
            <label for="password" class="text-sm font-medium leading-none text-foreground">
              Password
            </label>
            <Input
              id="password"
              type="password"
              name="password"
              required
              aria-invalid={passwordError ? "true" : undefined}
              aria-describedby={passwordError ? "password-error" : undefined}
            />
            {passwordError && (
              <p id="password-error" class="text-sm text-destructive">
                {passwordError}
              </p>
            )}
          </div>
          <div class="group/field flex w-full gap-2 flex-col *:w-full [&>.sr-only]:w-auto">
            <Button type="submit">{submitLabel}</Button>
          </div>
          {showOAuth && (
            <>
              <div class="relative -my-2 h-5 text-sm">
                <div class="absolute inset-0 top-1/2 h-px w-full bg-border"></div>
                <span class="relative mx-auto block w-fit bg-background px-2 text-muted-foreground">
                  Or
                </span>
              </div>
              <div class="grid gap-4 sm:grid-cols-2 group/field w-full flex-col *:w-full [&>.sr-only]:w-auto">
                <Button variant="outline" href="/api/auth/oauth/github">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                    ><path
                      fill="currentColor"
                      d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"
                    ></path></svg
                  >
                  Continue with GitHub
                </Button>
                <Button variant="outline" href="/api/auth/oauth/google">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                    ><path
                      fill="currentColor"
                      d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053z"
                    ></path></svg
                  >
                  Continue with Google
                </Button>
              </div>
            </>
          )}
        </div>
      </form>
    </div>
  </div>
</div>
