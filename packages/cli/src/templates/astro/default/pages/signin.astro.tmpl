---
import "@/styles/global.css";
import { actions, isInputError } from "astro:actions";
import { requireGuest } from "@aledx18/astro/protect";
import AuthForm from "@/components/AuthForm.astro";

const redirectResponse = requireGuest(Astro);
if (redirectResponse) return redirectResponse;

const result = Astro.getActionResult(actions.signin);
if (result && !result.error && result.data?.ok) {
  return Astro.redirect("/dashboard");
}

const inputErrors = isInputError(result?.error) ? result.error.fields : {};
const authError = result?.data && !result.data.ok ? result.data.error : undefined;
const errorParam = Astro.url.searchParams.get("error");
const registered = Astro.url.searchParams.get("registered");
const passwordChanged = Astro.url.searchParams.get("passwordChanged");

const successMessage = registered
  ? "Account created — check your email to confirm."
  : passwordChanged
    ? "Password updated — sign in with your new password."
    : undefined;
---

<html>
  <head><title>Sign in</title></head>
  <body>
    <AuthForm
      title="Sign in"
      submitLabel="Sign in"
      action={actions.signin}
      showOAuth
      successMessage={successMessage}
      authError={authError ?? errorParam ?? undefined}
      emailError={inputErrors.email?.join(", ")}
      passwordError={inputErrors.password?.join(", ")}
      subtitle={{ text: "Don't have an account?", linkText: "Sign up", href: "/register" }}
    />
  </body>
</html>
