---
import "@/styles/global.css";
import { actions, isInputError } from "astro:actions";
import { requireGuest } from "@aledx18/astro/protect";

const redirectResponse = requireGuest(Astro);
if (redirectResponse) return redirectResponse;

const result = Astro.getActionResult(actions.signin);
if (result && !result.error && result.data?.ok) {
  return Astro.redirect("/dashboard");
}

// biome-ignore lint/correctness/noUnusedVariables: used in template
const inputErrors = isInputError(result?.error) ? result.error.fields : {};
// biome-ignore lint/correctness/noUnusedVariables: used in template
const authError = result?.data && !result.data.ok ? result.data.error : undefined;
// biome-ignore lint/correctness/noUnusedVariables: used in template
const registered = Astro.url.searchParams.get("registered");
// biome-ignore lint/correctness/noUnusedVariables: used in template
const errorParam = Astro.url.searchParams.get("error");
// biome-ignore lint/correctness/noUnusedVariables: used in template
const passwordChanged = Astro.url.searchParams.get("passwordChanged");
---

<html>
  <head><title>Sign in</title></head>
  <body class="min-h-screen bg-slate-100 flex items-center justify-center p-4">
    <main class="w-full max-w-md bg-white rounded-2xl shadow-lg p-8">
      <h1 class="text-2xl font-bold text-slate-900 mb-6">Sign in</h1>
      {registered && <p class="mb-4 text-sm text-green-700 bg-green-50 border border-green-200 rounded-lg px-3 py-2">Account created — check your email to confirm.</p>}
      {passwordChanged && <p class="mb-4 text-sm text-green-700 bg-green-50 border border-green-200 rounded-lg px-3 py-2">Password updated — sign in with your new password.</p>}
      {errorParam && <p class="mb-4 text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg px-3 py-2">{errorParam}</p>}
      {authError && <p class="mb-4 text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg px-3 py-2">{authError}</p>}
      {inputErrors.email && <p class="mb-4 text-sm text-red-700">{inputErrors.email.join(", ")}</p>}
      {inputErrors.password && <p class="mb-4 text-sm text-red-700">{inputErrors.password.join(", ")}</p>}
      <form method="POST" action={actions.signin} class="space-y-4">
        <label class="block">
          <span class="block text-sm font-medium text-slate-700 mb-1">Email</span>
          <input type="email" name="email" required class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
        </label>
        <label class="block">
          <span class="block text-sm font-medium text-slate-700 mb-1">Password</span>
          <input type="password" name="password" required class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
        </label>
        <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition">Sign in</button>
      </form>
      <p class="mt-4 text-sm text-slate-600 text-center">
        <a href="/api/auth/oauth/google" class="text-blue-600 hover:underline">Google</a> · <a href="/api/auth/oauth/github" class="text-blue-600 hover:underline">GitHub</a>
      </p>
      <p class="mt-2 text-sm text-slate-600 text-center">
        <a href="/forgot-password" class="text-blue-600 hover:underline">Forgot your password?</a> · <a href="/register" class="text-blue-600 hover:underline">Create an account</a>
      </p>
    </main>
  </body>
</html>
